# HoneyTrace Environment Configuration (Example Template)
# Copy this file to .env and set your own API keys.
# NEVER commit .env to version control!

# Server Listen Address
HONEYTRACE_ADDR=:8080

# SQLite Database Path
HONEYTRACE_DB_PATH=/opt/honeytrace/data/honeytrace.db

# Cowrie Honeypot Log Path
HONEYTRACE_LOG_PATH=/home/cowrie/cowrie/var/log/cowrie/cowrie.json

# MaxMind GeoLite2 City Database Path
HONEYTRACE_GEOIP_PATH=/opt/honeytrace/data/GeoLite2-City.mmdb

# HoneyTrace API Authentication Key (Required for AI / Admin / Sensitive Endpoints)
HONEYTRACE_API_KEY=your_strong_random_api_key_here

# Groq Cloud API Key (for Blue Team AI SOC Analyst)
# Get a key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# AbuseIPDB API Key (for Live Threat Reputation Lookup)
# Get a key from https://www.abuseipdb.com
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# GreyNoise API Key (Optional)
GREYNOISE_API_KEY=your_greynoise_api_key_here
